{
  "name": "news-card",
  "version": "0.4.0",
  "description": "Claude Code skill that turns 65+ AI news sources into a curated 10-card visual digest (1080×1920 @2x).",
  "license": "MIT",
  "author": "Alex Huang",
  "homepage": "https://github.com/zerohzz/news-card",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerohzz/news-card.git"
  },
  "type": "module",
  "private": false,
  "scripts": {
    "fetch": "bash skills/news-card/scripts/fetch-all.sh",
    "score": "bash skills/news-card/scripts/score.sh",
    "screenshot": "bash skills/news-card/scripts/screenshot.sh",
    "digest": "bash skills/news-card/scripts/run-digest.sh",
    "verify:news-card": "node skills/news-card/scripts/lib/verify-fixtures.js",
    "verify:xhs-image": "node --test skills/xhs-image/scripts/generate.test.js",
    "xhs-image:generate": "node skills/xhs-image/scripts/generate.js"
  },
  "dependencies": {
    "playwright": "^1.52.0",
    "rss-parser": "^3.13.0"
  }
}
