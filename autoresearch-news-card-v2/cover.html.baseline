<!DOCTYPE html>
<!-- ⚠️ DENSITY CHECK: 封面页文字内容必须占据视觉面积的 60% 以上 -->
<!-- 参见 references/density-spec.md -->
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Source+Serif+Pro:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-primary: #FAF9F6;
    --bg-card: #FFFFFF;
    --text-primary: #1A1A1A;
    --text-secondary: #6B7280;
    --accent: #D97706;
    --divider: #E5E7EB;
    --cat-model-release: #4A90D9;
    --cat-product: #7B68EE;
    --cat-safety: #E74C3C;
    --cat-industry: #F39C12;
    --cat-devtools: #2ECC71;
    --cat-research: #1ABC9C;
    --cat-opensource: #E67E22;
    --cat-policy: #95A5A6;
    --cat-labor: #8E44AD;
    --font-zh: 'Noto Serif SC', 'Source Han Serif SC', serif;
    --font-en: 'Source Serif Pro', 'Noto Serif', serif;
    --radius-card: 12px;
    --radius-tag: 6px;
  }

  html, body {
    width: 1080px;
    height: 1920px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--bg-primary);
    font-family: var(--font-zh);
    color: var(--text-primary);
  }

  .page {
    width: 1080px;
    height: 1920px;
    display: flex;
    flex-direction: column;
    padding: 60px 56px 40px;
    box-sizing: border-box;
  }

  .header {
    text-align: center;
    margin-bottom: 40px;
  }

  .header .date {
    font-family: var(--font-en);
    font-size: 20px;
    color: var(--text-secondary);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .header h1 {
    font-size: 56px;
    font-weight: 900;
    margin: 8px 0 4px;
    line-height: 1.2;
  }

  .header .subtitle {
    font-size: 22px;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .divider {
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--divider));
    margin-bottom: 36px;
    border-radius: 2px;
  }

  .categories {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cat-group {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .cat-label {
    flex-shrink: 0;
    width: 96px;
    padding: 8px 0;
    border-radius: var(--radius-tag);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    line-height: 1.3;
  }

  .cat-items {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cat-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 12px;
    background: var(--bg-card);
    border-radius: var(--radius-tag);
    border-left: 4px solid transparent;
  }

  .cat-item .tier-badge {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: #FFF;
  }

  .cat-item .title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    flex: 1;
  }

  .cat-item .source {
    flex-shrink: 0;
    font-size: 14px;
    color: var(--text-secondary);
    font-family: var(--font-en);
  }

  .footer {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--divider);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    color: var(--text-secondary);
  }

  .footer .brand {
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-en);
  }
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="date">{{date}}</div>
    <h1>AI 日报</h1>
    <div class="subtitle">今日 AI 领域 {{total}} 条精选</div>
  </div>
  <div class="divider"></div>
  <div class="categories">
    {{#each categories}}
    <div class="cat-group">
      <div class="cat-label" style="background: {{color}}">{{name}}</div>
      <div class="cat-items">
        {{#each items}}
        <div class="cat-item" style="border-left-color: {{../color}}">
          <div class="tier-badge" style="background: {{../color}}">{{tier}}</div>
          <span class="title">{{headline_zh}}</span>
          <span class="source">{{source}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
  <div class="footer">
    <span class="brand">News Card</span>
    <span>{{date}} · 第 {{issue}} 期</span>
  </div>
</div>
</body>
</html>
