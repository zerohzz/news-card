# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# ---- Google Gemini (for Hero image + V3 cover generation) ----
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY is treated as an alias of GOOGLE_API_KEY.
GEMINI_API_KEY=

# Optional: override the default image model.
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Optional: override the API base URL (rarely needed).
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
